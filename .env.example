# Copy to .env and adjust. Never commit .env.

# Docker Compose Postgres (docker-compose.yml)
POSTGRES_USER=selah
POSTGRES_PASSWORD=selah
POSTGRES_DB=selah
POSTGRES_PORT=5432

# Used by dbmate, kysely-codegen and the API
DATABASE_URL=postgres://selah:selah@localhost:5432/selah?sslmode=disable

# API integration tests (ADR 0017): a separate database in the same Postgres
TEST_DATABASE_URL=postgres://selah:selah@localhost:5432/selah_test?sslmode=disable

# dbmate: migrations are the schema's source of truth; skip the pg_dump schema file
DBMATE_NO_DUMP_SCHEMA=true

# API
API_PORT=3000
# Sync (ADR 0028). When set, every request but the health check needs
# `Authorization: Bearer <token>`. Leave empty in development.
API_ACCESS_TOKEN=
# Browser origins allowed to call the API, comma-separated, e.g. https://elliemhwu.github.io
API_CORS_ORIGINS=
