          "twdAmount": {
            "type": "string",
            "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
            "example": "1234.00",
            "description": "Whole TWD. Omit to calculate it from amount × fxRate; set it to match a statement."
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "budgetItemId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          }
