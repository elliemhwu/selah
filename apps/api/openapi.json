  "info": {
    "title": "Selah API",
    "description": "Personal life management API. Money amounts are decimal strings.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "The API process is running."
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "description": "Whether the database answered a trivial query."
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "AccountType": {
        "type": "string",
        "enum": [
          "cash",
          "bank",
          "credit_card",
          "stored_value",
          "gift_card"
        ]
      },
      "Currency": {
        "type": "string",
        "enum": [
          "TWD",
          "JPY",
          "EUR",
          "GBP",
          "USD"
        ]
      },
      "AccountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Wallet"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountType"
              }
            ]
          },
          "currency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Currency"
              }
            ]
          },
          "openingBalance": {
            "type": "string",
            "example": "1000.00"
          },
          "balance": {
            "type": "string",
            "example": "850.00",
            "description": "Derived from the opening balance and all records (ADR 0011)."
          },
          "sortOrder": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "currency",
          "openingBalance",
          "balance",
          "sortOrder",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Bad Request"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "The request is invalid."
          },
          "errors": {
            "type": "object",
            "description": "Messages per field (400 and 422).",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": {
              "name": [
                "name should not be empty"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "UpsertAccountDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Wallet"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AccountType"
              }
            ]
          },
          "currency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Currency"
              }
            ]
          },
          "openingBalance": {
            "type": "string",
            "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
            "example": "1234.00",
            "description": "May be negative, e.g. a credit card that starts with debt."
          },
          "sortOrder": {
            "type": "number",
            "default": 0
          }
        },
        "required": [
          "name",
          "type",
          "currency",
          "openingBalance"
        ]
      },
      "CategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Food"
          },
          "parentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "sortOrder": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "parentId",
          "sortOrder",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpsertCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Food"
          },
          "parentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "sortOrder": {
            "type": "number",
            "default": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "RecordType": {
        "type": "string",
        "enum": [
          "income",
          "expense",
          "transfer",
          "adjustment"
        ]
      },
      "RecordLineDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
