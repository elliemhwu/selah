              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryDto"
                  }
                }
              }
            }
          }
        },
        "summary": "All categories as a flat list (tree via parentId)",
        "tags": [
          "finance: categories"
        ]
      }
    },
    "/api/v1/finance/categories/{id}": {
